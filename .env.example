# Copy to .env next to docker-compose.yml and fill in. Keep .env out of version control.

# The intercom key every Kiosk Satellite kiosk shares (Settings > Intercom > Intercom key).
KS_INTERCOM_KEY=

# The house word every TECHO5 device shares (its setup page).
TECHO5_HOUSE_WORD=

# The IP address of the machine running the bridge, as kiosks and TECHO5 devices reach it.
# Leave empty to use the address of the default route (or of MDNS_INTERFACE).
ADVERTISE_ADDRESS=
